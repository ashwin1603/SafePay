# Copy to .env and fill in. NEVER commit the real .env.
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite:///./safepay.db
RATE_LIMIT_PER_MINUTE=60

MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Payments: "simulated" (default, no real money) or "stripe"
PAYMENT_PROVIDER=simulated
# STRIPE_SECRET_KEY=sk_test_xxx        # use a TEST key; live keys are gated
# STRIPE_WEBHOOK_SECRET=whsec_xxx
ALLOW_LIVE_PAYMENTS=false

# Break-glass emergency access (audited). Disabled unless both are set.
BREAK_GLASS_ENABLED=false
# BREAK_GLASS_TOKEN=                    # >= 32 random chars
